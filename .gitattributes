# The corpus and the committed evaluation reports are read and regenerated on
# both Windows and Linux. Pinning line endings keeps a regenerated report a
# no-op diff rather than a whole-file rewrite.
data/**/*.json   text eol=lf
data/**/*.jsonl  text eol=lf
data/**/*.sol    text eol=lf
reports/*.md     text eol=lf
reports/*.json   text eol=lf

# Everything else is stored with LF in the repository and checked out with LF,
# so a Windows and a Linux working tree agree.
* text=auto eol=lf
